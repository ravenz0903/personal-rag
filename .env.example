# Backend environment variables. Configure secrets in Render, never in frontend variables.
SPRING_PROFILES_ACTIVE=cloud
# Supabase Connect > Session pooler. Use the JDBC format, SSL required, port 5432.
DATABASE_URL=jdbc:postgresql://POOLER_HOST:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres.PROJECT_REFERENCE
DATABASE_PASSWORD=REPLACE_IN_RENDER
SUPABASE_URL=https://PROJECT_REFERENCE.supabase.co
SUPABASE_PUBLIC_KEY=SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_KEY=REPLACE_WITH_BACKEND_ONLY_SERVICE_ROLE_KEY
TRACKER_OWNER_ID=OWNER_AUTH_USER_UUID
GEMINI_API_KEY=REPLACE_WITH_FREE_TIER_PROJECT_KEY
FRONTEND_URL=https://YOUR_PROJECT.vercel.app
REMINDERS_ENABLED=false
VAPID_PUBLIC_KEY=
